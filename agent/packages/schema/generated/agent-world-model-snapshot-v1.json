{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "current_era",
    "zone_history",
    "last_decisions",
    "player_first_seen_tick",
    "neg_domain_pending_tribulations",
    "neg_domain_escape_telemetry",
    "neg_domain_escape_sessions",
    "last_tick",
    "last_state_ts"
  ],
  "properties": {
    "current_era": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "name",
            "since_tick",
            "global_effect"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "since_tick": {
              "type": "integer"
            },
            "global_effect": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "zone_history": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "name",
              "spirit_qi",
              "danger_level",
              "active_events",
              "player_count"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "spirit_qi": {
                "minimum": -1,
                "maximum": 1,
                "type": "number"
              },
              "danger_level": {
                "minimum": 0,
                "maximum": 7,
                "type": "integer"
              },
              "status": {
                "anyOf": [
                  {
                    "const": "normal",
                    "type": "string"
                  },
                  {
                    "const": "race_out",
                    "type": "string"
                  },
                  {
                    "const": "collapsed",
                    "type": "string"
                  }
                ]
              },
              "active_events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "player_count": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "last_decisions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "commands",
            "narrations",
            "reasoning"
          ],
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "type",
                  "target",
                  "params"
                ],
                "properties": {
                  "type": {
                    "anyOf": [
                      {
                        "const": "spawn_event",
                        "type": "string"
                      },
                      {
                        "const": "spawn_npc",
                        "type": "string"
                      },
                      {
                        "const": "despawn_npc",
                        "type": "string"
                      },
                      {
                        "const": "faction_event",
                        "type": "string"
                      },
                      {
                        "const": "modify_zone",
                        "type": "string"
                      },
                      {
                        "const": "npc_behavior",
                        "type": "string"
                      },
                      {
                        "const": "heartbeat_override",
                        "type": "string"
                      }
                    ]
                  },
                  "target": {
                    "description": "区域名 or NPC ID",
                    "type": "string"
                  },
                  "params": {
                    "description": "指令参数。spawn_event: {event, intensity, duration_ticks, target_player?}; spawn_npc: {archetype, initial_age_ticks?, count?, reason?}; despawn_npc: {}; faction_event: {kind, faction_id, subject_id?, mission_id?, loyalty_delta?}; modify_zone: {spirit_qi_delta, danger_level_delta?}; npc_behavior: {flee_threshold}; heartbeat_override: {action, event_type, target_zone?, duration_ticks?, intensity_override?}",
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {}
                    }
                  }
                }
              }
            },
            "narrations": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "scope",
                  "text",
                  "style"
                ],
                "properties": {
                  "scope": {
                    "anyOf": [
                      {
                        "const": "broadcast",
                        "type": "string"
                      },
                      {
                        "const": "zone",
                        "type": "string"
                      },
                      {
                        "const": "player",
                        "type": "string"
                      }
                    ]
                  },
                  "target": {
                    "description": "zone name or player uuid, required when scope != broadcast",
                    "type": "string"
                  },
                  "text": {
                    "maxLength": 500,
                    "type": "string"
                  },
                  "style": {
                    "anyOf": [
                      {
                        "const": "system_warning",
                        "type": "string"
                      },
                      {
                        "const": "perception",
                        "type": "string"
                      },
                      {
                        "const": "narration",
                        "type": "string"
                      },
                      {
                        "const": "era_decree",
                        "type": "string"
                      },
                      {
                        "const": "political_jianghu",
                        "type": "string"
                      }
                    ]
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "death_insight",
                        "type": "string"
                      },
                      {
                        "const": "niche_intrusion",
                        "type": "string"
                      },
                      {
                        "const": "niche_intrusion_by_npc",
                        "type": "string"
                      },
                      {
                        "const": "npc_farm_pressure",
                        "type": "string"
                      },
                      {
                        "const": "scattered_cultivator",
                        "type": "string"
                      },
                      {
                        "const": "political_jianghu",
                        "type": "string"
                      },
                      {
                        "const": "war_outcome",
                        "type": "string"
                      },
                      {
                        "const": "dying_elder_appeared",
                        "type": "string"
                      },
                      {
                        "const": "dying_elder_dan_received",
                        "type": "string"
                      },
                      {
                        "const": "dying_elder_betrayal",
                        "type": "string"
                      },
                      {
                        "const": "dying_elder_dead_natural",
                        "type": "string"
                      },
                      {
                        "const": "dying_elder_dead_player_kill",
                        "type": "string"
                      }
                    ]
                  }
                }
              }
            },
            "reasoning": {
              "type": "string"
            }
          }
        }
      }
    },
    "player_first_seen_tick": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "integer"
        }
      }
    },
    "neg_domain_pending_tribulations": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "player_uuid",
            "player_name",
            "zone",
            "entered_at_tick",
            "last_suppressed_tick",
            "reason"
          ],
          "properties": {
            "player_uuid": {
              "type": "string"
            },
            "player_name": {
              "type": "string"
            },
            "zone": {
              "type": "string"
            },
            "entered_at_tick": {
              "type": "integer"
            },
            "last_suppressed_tick": {
              "type": "integer"
            },
            "reason": {
              "const": "negative_domain_tribulation_exempt",
              "type": "string"
            }
          }
        }
      }
    },
    "neg_domain_escape_telemetry": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "escape_entry_count",
        "post_escape_realm_drop_count",
        "successful_tribulation_avoidance_count",
        "active_escape_session_count",
        "post_escape_realm_drop_rate"
      ],
      "properties": {
        "escape_entry_count": {
          "minimum": 0,
          "type": "integer"
        },
        "post_escape_realm_drop_count": {
          "minimum": 0,
          "type": "integer"
        },
        "successful_tribulation_avoidance_count": {
          "minimum": 0,
          "type": "integer"
        },
        "active_escape_session_count": {
          "minimum": 0,
          "type": "integer"
        },
        "post_escape_realm_drop_rate": {
          "minimum": 0,
          "type": "number"
        }
      }
    },
    "neg_domain_escape_sessions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "player_uuid",
            "player_name",
            "zone",
            "entered_at_tick",
            "entry_realm_rank"
          ],
          "properties": {
            "player_uuid": {
              "type": "string"
            },
            "player_name": {
              "type": "string"
            },
            "zone": {
              "type": "string"
            },
            "entered_at_tick": {
              "type": "integer"
            },
            "entry_realm_rank": {
              "type": "number"
            }
          }
        }
      }
    },
    "last_tick": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_state_ts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
