# pickaxe_bone.obj -- plan-depth-loop-v1 P4 placeholder
# T-shaped tool: handle (0.06x0.8x0.06) + head (0.4x0.08x0.06) centered on top
mtllib pickaxe_bone.mtl
o pickaxe_bone

# Handle: centered at x=0, z=0, from y=0 to y=0.8
v -0.030  0.000 -0.030
v  0.030  0.000 -0.030
v  0.030  0.800 -0.030
v -0.030  0.800 -0.030
v -0.030  0.000  0.030
v  0.030  0.000  0.030
v  0.030  0.800  0.030
v -0.030  0.800  0.030

# Head: horizontal bar at top, centered on handle
v -0.200  0.720 -0.030
v  0.200  0.720 -0.030
v  0.200  0.800 -0.030
v -0.200  0.800 -0.030
v -0.200  0.720  0.030
v  0.200  0.720  0.030
v  0.200  0.800  0.030
v -0.200  0.800  0.030

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0

usemtl pickaxe_bone_mat_0
# Handle
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2 6/4/2
f 1/1/3 5/2/3 6/3/3 2/4/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 3/1/5 7/2/5 8/3/5 4/4/5
f 4/1/6 8/2/6 5/3/6 1/4/6

# Head
f  9/1/1 10/2/1 11/3/1 12/4/1
f 13/1/2 16/2/2 15/3/2 14/4/2
f  9/1/3 13/2/3 14/3/3 10/4/3
f 10/1/4 14/2/4 15/3/4 11/4/4
f 11/1/5 15/2/5 16/3/5 12/4/5
f 12/1/6 16/2/6 13/3/6  9/4/6
