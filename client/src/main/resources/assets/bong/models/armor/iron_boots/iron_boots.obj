# iron_boots.obj -- plan-depth-loop-v1 P1 placeholder
# Two flat boxes, 1.1x scale of player foot area (4x6x4 px = 0.25x0.375x0.25 units each)
# Half-extents per boot: 0.138 x, 0.138 z, height -0.04 to 0.41
# Same x-offsets as leggings
mtllib iron_boots.mtl
o iron_boots

# Left boot
v -0.263 -0.040 -0.150
v -0.050 -0.040 -0.150
v -0.050  0.413 -0.150
v -0.263  0.413 -0.150
v -0.263 -0.040  0.150
v -0.050 -0.040  0.150
v -0.050  0.413  0.150
v -0.263  0.413  0.150

# Right boot
v  0.050 -0.040 -0.150
v  0.263 -0.040 -0.150
v  0.263  0.413 -0.150
v  0.050  0.413 -0.150
v  0.050 -0.040  0.150
v  0.263 -0.040  0.150
v  0.263  0.413  0.150
v  0.050  0.413  0.150

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0

usemtl iron_boots_mat_0
# Left boot
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2 6/4/2
f 1/1/3 5/2/3 6/3/3 2/4/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 3/1/5 7/2/5 8/3/5 4/4/5
f 4/1/6 8/2/6 5/3/6 1/4/6

# Right boot
f  9/1/1 10/2/1 11/3/1 12/4/1
f 13/1/2 16/2/2 15/3/2 14/4/2
f  9/1/3 13/2/3 14/3/3 10/4/3
f 10/1/4 14/2/4 15/3/4 11/4/4
f 11/1/5 15/2/5 16/3/5 12/4/5
f 12/1/6 16/2/6 13/3/6  9/4/6
