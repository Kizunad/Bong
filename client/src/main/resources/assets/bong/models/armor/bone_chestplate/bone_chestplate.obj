# bone_chestplate.obj -- plan-depth-loop-v1 P4 placeholder
# Box 1.1x scale of player torso (8x12x4 px = 0.5x0.75x0.25 units)
# Half-extents: 0.35 x, 0.2 z, height 0.0 to 0.75
mtllib bone_chestplate.mtl
o bone_chestplate

v -0.350 -0.010 -0.200
v  0.350 -0.010 -0.200
v  0.350  0.760 -0.200
v -0.350  0.760 -0.200
v -0.350 -0.010  0.200
v  0.350 -0.010  0.200
v  0.350  0.760  0.200
v -0.350  0.760  0.200

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0

usemtl bone_chestplate_mat_0
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2 6/4/2
f 1/1/3 5/2/3 6/3/3 2/4/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 3/1/5 7/2/5 8/3/5 4/4/5
f 4/1/6 8/2/6 5/3/6 1/4/6
