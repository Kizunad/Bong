# bone_leggings.obj -- plan-depth-loop-v1 P4 placeholder
# Two boxes, 1.1x scale of player legs (4x10x3.5 px each)
# Half-extents per leg: 0.25 x, 0.175 z, height 0.0 to 0.65
# Gap between legs: 2 px = 0.125 units
mtllib bone_leggings.mtl
o bone_leggings

# Left leg (centered at x = -0.188)
v -0.313 -0.010 -0.175
v -0.063 -0.010 -0.175
v -0.063  0.660 -0.175
v -0.313  0.660 -0.175
v -0.313 -0.010  0.175
v -0.063 -0.010  0.175
v -0.063  0.660  0.175
v -0.313  0.660  0.175

# Right leg (centered at x = +0.188)
v  0.063 -0.010 -0.175
v  0.313 -0.010 -0.175
v  0.313  0.660 -0.175
v  0.063  0.660 -0.175
v  0.063 -0.010  0.175
v  0.313 -0.010  0.175
v  0.313  0.660  0.175
v  0.063  0.660  0.175

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0

usemtl bone_leggings_mat_0
# Left leg
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2 6/4/2
f 1/1/3 5/2/3 6/3/3 2/4/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 3/1/5 7/2/5 8/3/5 4/4/5
f 4/1/6 8/2/6 5/3/6 1/4/6

# Right leg
f  9/1/1 10/2/1 11/3/1 12/4/1
f 13/1/2 16/2/2 15/3/2 14/4/2
f  9/1/3 13/2/3 14/3/3 10/4/3
f 10/1/4 14/2/4 15/3/4 11/4/4
f 11/1/5 15/2/5 16/3/5 12/4/5
f 12/1/6 16/2/6 13/3/6  9/4/6
