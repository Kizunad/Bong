<?xml version="1.0" encoding="UTF-8"?>
<owo-ui>
    <!-- 死亡屏布局由 XML 持有，Java 只绑定快照、按钮意图和 cinematic 桥接。 -->
    <components>
        <flow-layout direction="vertical">
            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
            <surface>
                <vanilla-translucent />
            </surface>
            <padding><all>10</all></padding>
            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
            <children>
                <flow-layout id="death-panel" direction="vertical">
                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="fixed">208</vertical>
                    </sizing>
                    <surface>
                        <flat>#120F14</flat>
                        <outline>#60404A</outline>
                    </surface>
                    <padding><all>10</all></padding>
                    <gap>5</gap>
                    <horizontal-alignment>center</horizontal-alignment>
                    <children>
                        <label id="death-title">
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content">0</vertical>
                            </sizing>
                            <color>#FFFF4040</color>
                            <shadow>true</shadow>
                            <horizontal-text-alignment>center</horizontal-text-alignment>
                        </label>
                        <scroll id="death-content-scroll" direction="vertical">
                            <flow-layout id="death-scroll-content" direction="vertical">
                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="content" />
                                </sizing>
                                <gap>4</gap>
                                <horizontal-alignment>center</horizontal-alignment>
                                <children>
                                    <label id="death-luck">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <color>#FFE0E0E0</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <flow-layout id="death-luck-track" direction="horizontal">
                                        <sizing>
                                            <horizontal method="fixed">220</horizontal>
                                            <vertical method="fixed">6</vertical>
                                        </sizing>
                                        <surface>
                                            <flat>#303030</flat>
                                            <outline>#101010</outline>
                                        </surface>
                                        <children>
                                            <flow-layout id="death-luck-fill" direction="horizontal">
                                                <sizing>
                                                    <horizontal method="fixed">0</horizontal>
                                                    <vertical method="fill">100</vertical>
                                                </sizing>
                                            </flow-layout>
                                        </children>
                                    </flow-layout>
                                    <label id="death-phase">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <color>#FFDDDDDD</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <label id="death-countdown">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <color>#FFFF4040</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <label id="death-lifespan">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <max-width>520</max-width>
                                        <color>#FFDDDDDD</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <label id="death-final-words-title">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <color>#FFFF4040</color>
                                        <shadow>true</shadow>
                                        <text>遗念</text>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <label id="death-final-words">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <max-width>520</max-width>
                                        <color>#FFDDDDDD</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                        <line-height>12</line-height>
                                    </label>
                                    <label id="death-feedback">
                                        <sizing>
                                            <horizontal method="fill">100</horizontal>
                                            <vertical method="content">0</vertical>
                                        </sizing>
                                        <max-width>520</max-width>
                                        <color>#FFFF8080</color>
                                        <horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                </children>
                            </flow-layout>
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="fixed">132</vertical>
                            </sizing>
                            <scrollbar-thiccness>3</scrollbar-thiccness>
                        </scroll>
                        <flow-layout id="death-actions" direction="horizontal">
                            <sizing>
                                <horizontal method="fixed">208</horizontal>
                                <vertical method="fixed">20</vertical>
                            </sizing>
                            <gap>8</gap>
                            <children>
                                <button id="death-reincarnate">
                                    <sizing>
                                        <horizontal method="fixed">100</horizontal>
                                        <vertical method="fixed">20</vertical>
                                    </sizing>
                                    <text>重生</text>
                                    <renderer><vanilla /></renderer>
                                </button>
                                <button id="death-terminate">
                                    <sizing>
                                        <horizontal method="fixed">100</horizontal>
                                        <vertical method="fixed">20</vertical>
                                    </sizing>
                                    <text>终结</text>
                                    <renderer><vanilla /></renderer>
                                </button>
                            </children>
                        </flow-layout>
                    </children>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
</owo-ui>
