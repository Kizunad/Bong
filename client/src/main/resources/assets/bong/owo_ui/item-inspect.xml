<?xml version="1.0" encoding="UTF-8"?>
<owo-ui>
    <components><template name="content" /></components>
    <templates>
        <template name="content">
            <flow-layout direction="vertical">
                <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                <children>
                    <scroll direction="vertical">
                        <flow-layout direction="vertical">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                            <padding><all>10</all></padding>
                            <gap>8</gap>
                            <children>
                                <flow-layout id="item-icon" direction="vertical">
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                    <horizontal-alignment>right</horizontal-alignment>
                                </flow-layout>
                                <flow-layout id="item-details" direction="vertical">
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                </flow-layout>
                                <flow-layout id="item-notes" direction="vertical">
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                    <gap>6</gap>
                                </flow-layout>
                            </children>
                        </flow-layout>
                        <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                    </scroll>
                </children>
            </flow-layout>
        </template>
        <template name="view-toggle">
            <button id="item-view-toggle">
                <text>3D</text><tooltip>切换物品视图</tooltip><text-shadow>false</text-shadow>
                <sizing><horizontal method="fixed">30</horizontal><vertical method="fixed">18</vertical></sizing>
                <renderer><flat color="#454A42" hovered-color="#656C5C" disabled-color="#343833" /></renderer>
            </button>
        </template>
        <template name="detail-row">
            <flow-layout direction="horizontal">
                <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                <padding><top>4</top><bottom>5</bottom></padding>
                <children>
                    <label id="detail-label">
                        <sizing><horizontal method="fill">38</horizontal><vertical method="content" /></sizing>
                        <text> </text><color>#A6AFA8</color>
                    </label>
                    <label id="detail-value">
                        <sizing><horizontal method="fill">62</horizontal><vertical method="content" /></sizing>
                        <text> </text><color>#E2E7DF</color>
                        <horizontal-text-alignment>right</horizontal-text-alignment>
                    </label>
                </children>
            </flow-layout>
        </template>
        <template name="paragraph">
            <label>
                <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                <text> </text><color>#BAC5B9</color><line-height>13</line-height>
            </label>
        </template>
    </templates>
</owo-ui>
