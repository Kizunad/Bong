<?xml version="1.0" encoding="UTF-8"?>
<owo-ui>
    <components>
        <flow-layout direction="vertical">
            <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
            <padding><all>16</all></padding>
            <horizontal-alignment>center</horizontal-alignment><vertical-alignment>center</vertical-alignment>
            <children>
                <flow-layout id="terminate-panel" direction="vertical">
                    <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                    <gap>8</gap><horizontal-alignment>center</horizontal-alignment>
                    <children>
                        <label id="terminate-title">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="fixed">28</vertical></sizing>
                        </label>
                        <label id="terminate-epilogue">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="fixed">24</vertical></sizing>
                            <color>#FF9AA79F</color><horizontal-text-alignment>center</horizontal-text-alignment>
                        </label>
                        <scroll id="terminate-content-scroll" direction="vertical">
                            <flow-layout direction="vertical">
                                <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                <gap>12</gap><horizontal-alignment>center</horizontal-alignment>
                                <children>
                                    <label id="terminate-voice">
                                        <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                        <color>#FFB7A089</color><horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <label id="terminate-verdict">
                                        <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                        <color>#FFD5DBD5</color><horizontal-text-alignment>center</horizontal-text-alignment><line-height>17</line-height>
                                    </label>
                                    <label id="terminate-record-heading">
                                        <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                        <text>此生留痕</text><color>#FFD5A18D</color><horizontal-text-alignment>center</horizontal-text-alignment>
                                    </label>
                                    <flow-layout direction="horizontal">
                                        <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                        <gap>12</gap>
                                        <children>
                                            <label id="terminate-summary-left">
                                                <sizing><horizontal method="fill">48</horizontal><vertical method="content">0</vertical></sizing>
                                                <color>#FFC8D0C9</color><line-height>16</line-height>
                                            </label>
                                            <label id="terminate-summary-right">
                                                <sizing><horizontal method="fill">48</horizontal><vertical method="content">0</vertical></sizing>
                                                <color>#FFC8D0C9</color><line-height>16</line-height>
                                            </label>
                                        </children>
                                    </flow-layout>
                                    <label id="terminate-final-words">
                                        <sizing><horizontal method="fill">100</horizontal><vertical method="content">0</vertical></sizing>
                                        <color>#FF9AA79F</color><horizontal-text-alignment>center</horizontal-text-alignment><line-height>14</line-height>
                                    </label>
                                </children>
                            </flow-layout>
                            <sizing><horizontal method="fill">100</horizontal><vertical method="fixed">180</vertical></sizing>
                            <scrollbar-thiccness>2</scrollbar-thiccness>
                        </scroll>
                        <label id="terminate-feedback">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="fixed">22</vertical></sizing>
                            <color>#FFD5A18D</color><horizontal-text-alignment>center</horizontal-text-alignment>
                        </label>
                        <button id="terminate-create-character">
                            <sizing><horizontal method="fixed">180</horizontal><vertical method="fixed">28</vertical></sizing>
                            <text>另启一生</text>
                        </button>
                    </children>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
</owo-ui>
