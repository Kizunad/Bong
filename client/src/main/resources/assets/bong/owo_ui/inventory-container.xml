<?xml version="1.0" encoding="UTF-8"?>
<owo-ui>
    <components><template name="content" /></components>
    <templates>
        <template name="content">
            <flow-layout direction="vertical">
                <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                <children>
                    <scroll id="container-vertical" direction="vertical">
                        <flow-layout direction="vertical">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                            <padding><all>8</all></padding><gap>6</gap>
                            <children>
                                <label id="container-summary">
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                    <text> </text><color>#A6AFA8</color>
                                </label>
                                <flow-layout id="container-preparation" direction="vertical">
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                </flow-layout>
                                <scroll id="container-horizontal" direction="horizontal">
                                    <flow-layout id="container-grid" direction="vertical">
                                        <sizing><horizontal method="content" /><vertical method="content" /></sizing>
                                        <padding><bottom>6</bottom></padding>
                                    </flow-layout>
                                    <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                                    <scrollbar-thiccness>4</scrollbar-thiccness>
                                </scroll>
                            </children>
                        </flow-layout>
                        <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                        <scrollbar-thiccness>4</scrollbar-thiccness>
                    </scroll>
                </children>
            </flow-layout>
        </template>
        <template name="launcher">
            <flow-layout direction="vertical">
                <sizing><horizontal method="fixed">116</horizontal><vertical method="content" /></sizing>
                <padding><all>6</all></padding><gap>4</gap>
                <children>
                    <label><text>随身容器</text><color>#A6AFA8</color></label>
                    <flow-layout id="container-entries" direction="vertical">
                        <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                        <gap>3</gap>
                    </flow-layout>
                </children>
            </flow-layout>
        </template>
        <template name="container-entry">
            <button>
                <text> </text><text-shadow>false</text-shadow>
                <sizing><horizontal method="fill">100</horizontal><vertical method="fixed">22</vertical></sizing>
                <renderer><flat color="#FF303A39" hovered-color="#FF485652" disabled-color="#FF242C2B" /></renderer>
            </button>
        </template>
    </templates>
</owo-ui>
