<?xml version="1.0" encoding="UTF-8"?>
<owo-ui>
    <components><template name="content" /></components>
    <templates>
        <template name="content">
            <flow-layout direction="vertical">
                <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                <children>
                    <scroll id="loadout-scroll" direction="vertical">
                        <flow-layout direction="vertical">
                            <sizing><horizontal method="fill">100</horizontal><vertical method="content" /></sizing>
                            <padding><all>8</all></padding><gap>8</gap>
                            <horizontal-alignment>center</horizontal-alignment>
                            <children>
                                <label><text>物品快捷</text><color>#B8C9B9</color></label>
                                <flow-layout id="quick-use-slots" direction="horizontal">
                                    <sizing><horizontal method="content" /><vertical method="content" /></sizing>
                                    <gap>8</gap>
                                </flow-layout>
                                <label><text>战斗技能</text><color>#D0C6A6</color></label>
                                <flow-layout id="combat-slots" direction="horizontal">
                                    <sizing><horizontal method="content" /><vertical method="content" /></sizing>
                                    <gap>8</gap>
                                </flow-layout>
                            </children>
                        </flow-layout>
                        <sizing><horizontal method="fill">100</horizontal><vertical method="fill">100</vertical></sizing>
                        <scrollbar-thiccness>4</scrollbar-thiccness>
                    </scroll>
                </children>
            </flow-layout>
        </template>
    </templates>
</owo-ui>
