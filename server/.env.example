MINESKIN_API_KEY=msk_replace_me

# 仅测试环境开启固定场景 /scene；默认关闭，修改后重启服务端生效。
# 仍受 BONG_OPERATORS 管理员权限控制，离线服需显式信任 BONG_OPERATORS_ALLOW_OFFLINE=1。
# 采集 HUD：/scene test_gathering_herb_1、test_gathering_ore_1、test_gathering_wood_1。
# 站定 8 秒完成，移动或受击中断；/scene clear 清理，不产出物品。
# 临时显示对应铁制工具，结束后恢复当前装备外观，不写入背包存档。
BONG_TEST_ENV=false
